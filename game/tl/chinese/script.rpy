    old "Jack doesn't kill Grace."
    new "Jack 没有杀 Grace。"

    # game/script.rpy:13600
    old "Jack kills Anna."
    new "Jack 杀了 Anna。"

    # game/script.rpy:13600
    old "Jack doesn't kill Anna."
    new "Jack 没有杀 Anna。"

